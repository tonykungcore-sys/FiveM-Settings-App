<UserControl x:Class="FiveMSettingsApp.Views.AudioSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundColor}">
    <StackPanel Margin="20">
        <!-- Header -->
        <TextBlock Text="Audio Settings" FontSize="24" FontWeight="Bold" 
                   Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

        <!-- Master Volume -->
        <Border Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Master Volume" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="MasterVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="70" 
                            Foreground="{StaticResource AccentColor}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MasterVolumeLabel" Grid.Column="1" Text="70%" FontSize="14" 
                               Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Game Volume -->
        <Border Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Game Volume" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="GameVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="85" 
                            Foreground="{StaticResource AccentColor}" Margin="0,0,15,0" VerticalAlignment="Center"
                            ValueChanged="GameVolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="GameVolumeLabel" Grid.Column="1" Text="85%" FontSize="14" 
                               Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Voice Volume -->
        <Border Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Voice Chat Volume" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="VoiceVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="60" 
                            Foreground="{StaticResource AccentColor}" Margin="0,0,15,0" VerticalAlignment="Center"
                            ValueChanged="VoiceVolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="VoiceVolumeLabel" Grid.Column="1" Text="60%" FontSize="14" 
                               Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Audio Device Selection -->
        <Border Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Output Device" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,10"/>
                <ComboBox x:Name="OutputDeviceCombo" Background="{StaticResource ButtonHoverColor}" 
                          Foreground="{StaticResource TextColor}" Padding="10" Height="35" FontSize="12">
                    <ComboBoxItem IsSelected="True">Speakers (Realtek Audio)</ComboBoxItem>
                    <ComboBoxItem>Headphones</ComboBoxItem>
                    <ComboBoxItem>HDMI Audio</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Microphone -->
        <Border Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Microphone" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,10"/>
                <ComboBox x:Name="MicrophoneCombo" Background="{StaticResource ButtonHoverColor}" 
                          Foreground="{StaticResource TextColor}" Padding="10" Height="35" FontSize="12" Margin="0,0,0,15">
                    <ComboBoxItem IsSelected="True">Microphone (Realtek Audio)</ComboBoxItem>
                    <ComboBoxItem>USB Headset</ComboBoxItem>
                    <ComboBoxItem>Virtual Audio Cable</ComboBoxItem>
                </ComboBox>
                
                <TextBlock Text="Microphone Volume" FontSize="12" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="MicVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="80" 
                            Foreground="{StaticResource AccentColor}" Margin="0,0,15,0" VerticalAlignment="Center"
                            ValueChanged="MicVolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="MicVolumeLabel" Grid.Column="1" Text="80%" FontSize="14" 
                               Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Audio Enhancements -->
        <Border Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Audio Enhancements" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,15"/>
                
                <CheckBox Content="Enable Spatial Audio" Foreground="{StaticResource TextColor}" 
                          Margin="0,5" IsChecked="True" Padding="10"/>
                <CheckBox Content="Voice Modulation" Foreground="{StaticResource TextColor}" 
                          Margin="0,5" IsChecked="False" Padding="10"/>
                <CheckBox Content="Noise Suppression" Foreground="{StaticResource TextColor}" 
                          Margin="0,5" IsChecked="True" Padding="10"/>
                <CheckBox Content="Echo Cancellation" Foreground="{StaticResource TextColor}" 
                          Margin="0,5" IsChecked="True" Padding="10"/>
            </StackPanel>
        </Border>

        <!-- Test Audio -->
        <Button Content="🔊 Test Audio Output" Background="{StaticResource AccentColor}" 
                Foreground="#000000" Padding="15" FontSize="14" FontWeight="Bold" 
                CornerRadius="5" Height="40" Click="TestAudioBtn_Click" Margin="0,0,0,10"/>

        <Button Content="🎙️ Test Microphone" Background="{StaticResource CardColor}" 
                Foreground="{StaticResource TextColor}" Padding="15" FontSize="14" 
                BorderThickness="1" BorderBrush="{StaticResource AccentColor}"
                CornerRadius="5" Height="40" Click="TestMicBtn_Click"/>
    </StackPanel>
</UserControl>
