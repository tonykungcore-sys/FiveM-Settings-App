<UserControl x:Class="FiveMSettingsApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundColor}">
    <StackPanel Margin="20">
        <!-- Header -->
        <TextBlock Text="System Overview" FontSize="24" FontWeight="Bold" 
                   Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

        <!-- System Stats Grid -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Column="0" Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CPU" FontSize="12" Foreground="{StaticResource SecondaryTextColor}"/>
                    <TextBlock x:Name="CPUValue" Text="0%" FontSize="28" FontWeight="Bold" 
                               Foreground="{StaticResource AccentColor}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="CPUTemp" Text="40°C" FontSize="12" Foreground="{StaticResource SecondaryTextColor}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- RAM Card -->
            <Border Grid.Column="1" Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="RAM" FontSize="12" Foreground="{StaticResource SecondaryTextColor}"/>
                    <TextBlock x:Name="RAMValue" Text="43%" FontSize="28" FontWeight="Bold" 
                               Foreground="{StaticResource AccentColor}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="RAMUsage" Text="6.9 / 15.8 GB" FontSize="12" Foreground="{StaticResource SecondaryTextColor}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Disk Card -->
            <Border Grid.Column="2" Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="DISK" FontSize="12" Foreground="{StaticResource SecondaryTextColor}"/>
                    <TextBlock x:Name="DiskValue" Text="53%" FontSize="28" FontWeight="Bold" 
                               Foreground="{StaticResource AccentColor}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="DiskUsage" Text="163 / 305 GB" FontSize="12" Foreground="{StaticResource SecondaryTextColor}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ping Card -->
            <Border Grid.Column="3" Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="PING" FontSize="12" Foreground="{StaticResource SecondaryTextColor}"/>
                    <TextBlock x:Name="PingValue" Text="13ms" FontSize="28" FontWeight="Bold" 
                               Foreground="{StaticResource AccentColor}" Margin="0,10,0,0"/>
                    <TextBlock Text="Excellent" FontSize="12" Foreground="#00ff00" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Quick Actions -->
        <TextBlock Text="Quick Actions" FontSize="18" FontWeight="Bold" 
                   Foreground="{StaticResource TextColor}" Margin="0,30,0,15"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Background="{StaticResource CardColor}" Foreground="{StaticResource TextColor}" 
                    Padding="15" Margin="0,0,10,0" CornerRadius="5" Height="70">
                <StackPanel>
                    <TextBlock Text="🚀" FontSize="20"/>
                    <TextBlock Text="Optimize System" FontSize="12" Margin="0,5,0,0"/>
                    <TextBlock Text="Improve overall performance" FontSize="10" Foreground="{StaticResource SecondaryTextColor}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Background="{StaticResource CardColor}" Foreground="{StaticResource TextColor}" 
                    Padding="15" Margin="10,0,10,0" CornerRadius="5" Height="70">
                <StackPanel>
                    <TextBlock Text="🧹" FontSize="20"/>
                    <TextBlock Text="Clean Junk Files" FontSize="12" Margin="0,5,0,0"/>
                    <TextBlock Text="Free up space and boost performance" FontSize="10" Foreground="{StaticResource SecondaryTextColor}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Background="{StaticResource CardColor}" Foreground="{StaticResource TextColor}" 
                    Padding="15" Margin="10,0,0,0" CornerRadius="5" Height="70">
                <StackPanel>
                    <TextBlock Text="⬆️" FontSize="20"/>
                    <TextBlock Text="Check Updates" FontSize="12" Margin="0,5,0,0"/>
                    <TextBlock Text="Keep everything up to date" FontSize="10" Foreground="{StaticResource SecondaryTextColor}"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
