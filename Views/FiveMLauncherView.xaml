<UserControl x:Class="FiveMSettingsApp.Views.FiveMLauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundColor}">
    <StackPanel Margin="20">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="⚡" FontSize="32" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FiveM Power Plan & Latency Tweaks" FontSize="22" FontWeight="Bold" 
                           Foreground="{StaticResource TextColor}"/>
                <TextBlock Text="Edit PowerPlan For Gaming Lower input lag" FontSize="12" 
                           Foreground="{StaticResource AccentColor}"/>
            </StackPanel>
        </StackPanel>

        <!-- Power Plan Tweaks -->
        <Border Background="{StaticResource CardColor}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <CheckBox Content='Import & Activate "ASPAS" Power Plan (Ultimate Perf.)' 
                          Foreground="{StaticResource TextColor}" IsChecked="True" Padding="10" Margin="0,5" FontSize="12"/>
                <CheckBox Content="Disable Hibernate, Fast Boot & Power Throttling" 
                          Foreground="{StaticResource TextColor}" IsChecked="True" Padding="10" Margin="0,5" FontSize="12"/>
                <CheckBox Content="Maximize CPU Boost Policy (EPP to 0, Aggressive Boost)" 
                          Foreground="{StaticResource TextColor}" IsChecked="True" Padding="10" Margin="0,5" FontSize="12"/>
                <CheckBox Content="Minimize Delay (PCIe Link State, Disks, USB, Graphics)" 
                          Foreground="{StaticResource TextColor}" IsChecked="True" Padding="10" Margin="0,5" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Apply Button -->
        <Button Content="⚙️ Apply Power Plan Tweaks" Background="{StaticResource AccentColor}" 
                Foreground="#000000" Padding="15" FontSize="14" FontWeight="Bold" 
                CornerRadius="5" Height="45" Click="ApplyPowerPlanBtn_Click"/>
    </StackPanel>
</UserControl>
